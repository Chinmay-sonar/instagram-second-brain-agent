# ==========================================
# INSTAGRAM SECOND BRAIN AGENT - CONFIGURATION
# ==========================================

# 1. Telegram Bot Credentials
# Get token from https://t.me/botfather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Get your ID from https://t.me/userinfobot
TELEGRAM_ALLOWED_USER_ID="your_telegram_chat_id_here"

# 2. Obsidian Storage
# Full path to your Obsidian Vault folder where resources will be saved
# Example: "C:/Users/Asus/Documents/SecondBrain/Resources"
OBSIDIAN_VAULT_PATH="C:/Users/Asus/Documents/SecondBrain/Resources"

# 3. AI Brain APIs
# Google AI Studio (Free Gemini API Key): https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# NVIDIA NIM API Key (already have this): https://build.nvidia.com/
NVIDIA_API_KEY="your_nvidia_api_key_here"

# 4. Optional: Burner Instagram Account (for Tier 3 auto-comment/DM listening)
# Leave blank if you only want Tier 1 (Vision) + Tier 2 (Bio scanner)
INSTAGRAM_BURNER_USERNAME=""
INSTAGRAM_BURNER_PASSWORD=""
